# Copy this file to .env and fill in your project values.
# Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gemini AI API Keys (Get free keys from https://aistudio.google.com/app/apikey)
# Option A: Single Key for everything (default fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Dual Dedicated Keys (Separates quotas for high performance):
# 1. Dedicated Key for Multimodal OCR & Medication Extraction
VITE_GEMINI_OCR_KEY=your_gemini_ocr_key_here

# 2. Dedicated Key for Predictive Health Analytics & Doctor Clinical Summaries
VITE_GEMINI_ANALYTICS_KEY=your_gemini_analytics_key_here

# Option C: High-Speed Groq LLM Key (Get free key from https://console.groq.com/keys)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here
